#include<stdio.h>

int main()
{
    int a, b, quotient , remainder;
    printf("enter the value of a\n");
    scanf("%d",&a);
    printf("enter the value of b\n");
    scanf("%d",&b);
    quotient = a/b;
    remainder = a%b;
    printf("the quotient is :%d\n",quotient);
    printf("the remainder is :%d\n",remainder);
    return 0;
}
