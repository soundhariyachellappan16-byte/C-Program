#include<stdio.h>
int main()
{
    int x = 20, y =50;
    printf(" the sum of two numbers is %d\n",x+y);
    printf(" the difference is %d\n",x-y);
    printf(" the product is %d\n",x*y);
    printf(" the quotient is %d\n",x/y);
    printf("the remainder is %d\n",x%y);
    printf(" increment answer %d\n",++x);
    printf("decrement operator %d\n",--x);
    return 0;
}
